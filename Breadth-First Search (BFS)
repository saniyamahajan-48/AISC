from collections import deque
graph = {     "A": ["B", "D", "E"],
    "B": ["A", "C", "E"],
    "C": ["B", "E", "F", "G"],
    "D": ["A", "E"],
    "E": ["A", "B", "C", "D", "F"],
    "F": ["C", "E", "G"],
    "G": ["C", "F"] }
def bfs_path(start, goal):
    queue = deque([(start, [start])])     visited = {start}     while queue:
        node, path = queue.popleft()         if node == goal:             return path         for neighbour in graph[node]:             if neighbour not in visited:                 visited.add(neighbour)                 queue.append((neighbour, path + [neighbour]))     return None
print("BFS path:", " -> ".join(bfs_path("A", "G")))
