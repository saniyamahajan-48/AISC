import numpy as np 
import matplotlib.pyplot as plt
x = np.linspace(0, 10, 300) 
def triangular(x, a, b, c):
    return np.maximum(np.minimum((x-a)/(b-a), (c-x)/(c-b)), 0) 
def trapezoidal(x, a, b, c, d):
    return np.maximum(np.minimum(np.minimum((x-a)/(b-a+1e-9), 1), (d-x)/(d-c+1e-9)), 0) 
def gaussian(x, mean, sigma):     
return np.exp(-0.5*((x-mean)/sigma)**2)
plt.plot(x, triangular(x,0,2,5), 
label="Lightly soiled (triangular)") 
plt.plot(x, trapezoidal(x,2,4,6,8), 
label="Moderately soiled (trapezoidal)") 
plt.plot(x, gaussian(x,8,1.2), 
label="Heavily soiled (Gaussian)") 
plt.xlabel("Soil level"); 
plt.ylabel("Membership degree") 
plt.title("Washing machine soil membership functions") 
plt.legend(); 
plt.grid(True); 
plt.show() 
