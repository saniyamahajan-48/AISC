graph = {     "A": ["B", "C"],
    "B": ["D", "E"],
    "D": [],
    "E": ["H"],
    "H": [],
    "C": ["F", "G"],
    "F": [],
    "G": [] }
def dfs_path(node, goal, path=None):     if path is None:         path = []     path = path + [node]     if node == goal:         return path     for neighbour in graph[node]:
        result = dfs_path(neighbour, goal, path)         if result:             return result     return None
print("DFS path:", " -> ".join(dfs_path("A", "G")))
